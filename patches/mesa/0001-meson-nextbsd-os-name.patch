Description: Treat a host_machine.system() of 'nextbsd' like 'freebsd'
 NextBSD's uname -s is NextBSD, so a native meson build sees the system
 'nextbsd'. Without these four hunks Mesa turns DRM/KMS off (and with it GBM
 and the KMS drivers), passes -mtls-dialect, drops _GNU_SOURCE and adds
 -Werror=thread-safety. The cross files in cross/meson declare
 system = 'freebsd' (E23 D12), so in this repo's own build the hunks are
 inert; they are carried so a native build on NextBSD takes the same paths.
 The port file's POWER8 hunk (__builtin_altivec_vgbbd) is dropped: no PowerPC.
Origin: nextbsd-ports 6201470e03d4, graphics/mesa-dri/files/patch-meson.build
 (the NextBSD hunks; added in d3479089952d)
Forwarded: no
---
--- a/meson.build
+++ b/meson.build
@@ -159,7 +159,7 @@
 
 with_any_opengl = with_opengl or with_gles1 or with_gles2
 
-system_has_kms_drm = ['openbsd', 'netbsd', 'freebsd', 'gnu/kfreebsd', 'dragonfly', 'linux', 'sunos', 'android', 'managarm'].contains(host_machine.system())
+system_has_kms_drm = ['openbsd', 'netbsd', 'freebsd', 'nextbsd', 'gnu/kfreebsd', 'dragonfly', 'linux', 'sunos', 'android', 'managarm'].contains(host_machine.system())
 
 gallium_drivers = get_option('gallium-drivers')
 if gallium_drivers.contains('auto')
@@ -637,7 +637,7 @@
   # cross-compiling, but because this is just an optimization we can skip it
   if meson.is_cross_build() and not meson.can_run_host_binaries()
     warning('cannot auto-detect -mtls-dialect when cross-compiling, using compiler default')
-  elif host_machine.system() == 'freebsd'
+  elif ['freebsd', 'nextbsd'].contains(host_machine.system())
     warning('cannot use -mtls-dialect for FreeBSD, using compiler default')
   else
     # The way to specify the TLSDESC dialect is architecture-specific.
@@ -1249,7 +1249,7 @@
 endif
 
 # TODO: this is very incomplete
-if ['linux', 'cygwin', 'gnu', 'freebsd', 'gnu/kfreebsd', 'haiku', 'android', 'managarm'].contains(host_machine.system())
+if ['linux', 'cygwin', 'gnu', 'freebsd', 'nextbsd', 'gnu/kfreebsd', 'haiku', 'android', 'managarm'].contains(host_machine.system())
   pre_args += '-D_GNU_SOURCE'
 elif host_machine.system() == 'sunos'
   pre_args += '-D__EXTENSIONS__'
@@ -1376,7 +1376,7 @@
   endif
 
   # FreeBSD annotated <pthread.h> but Mesa isn't ready
-  if not (cc.get_id() == 'clang' and host_machine.system() == 'freebsd')
+  if not (cc.get_id() == 'clang' and ['freebsd', 'nextbsd'].contains(host_machine.system()))
     _trial_c += ['-Werror=thread-safety']
   endif
 
