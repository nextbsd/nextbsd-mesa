Description: intel: retry I915_GEM_USERPTR unsynchronized on ENODEV
 drm-kmod's i915 has no MMU-notifier userptr, so the plain ioctl fails with
 ENODEV; retry with I915_USERPTR_UNSYNCHRONIZED (crocus, iris, hasvk, anv).
 Upstream MR mesa!13162 was closed unmerged, so this is carried. The iris and
 crocus hunks are compiled once those drivers are built (README, Intel);
 the anv and hasvk hunks with Vulkan (phase 2, nextbsd-mesa#2).
Origin: nextbsd-ports d3479089952d, graphics/mesa-dri/files/patch-userptr
 (inherited unchanged from the FreeBSD port graphics/mesa-dri;
 https://github.com/FreeBSDDesktop/kms-drm/issues/197,
 https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/13162)
Forwarded: https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/13162 (closed)
---
--- a/src/gallium/drivers/crocus/crocus_bufmgr.c
+++ b/src/gallium/drivers/crocus/crocus_bufmgr.c
@@ -488,8 +488,20 @@
       .user_ptr = (uintptr_t)ptr,
       .user_size = size,
    };
-   if (intel_ioctl(bufmgr->fd, DRM_IOCTL_I915_GEM_USERPTR, &arg))
+
+   int ret;
+retry:
+   ret = intel_ioctl(bufmgr->fd, DRM_IOCTL_I915_GEM_USERPTR, &arg);
+   if (ret) {
+      if (errno == ENODEV && arg.flags == 0) {
+         arg.flags = I915_USERPTR_UNSYNCHRONIZED;
+         goto retry;
+      }
+      if (geteuid() != 0) {
+         fprintf(stderr, "%s", "ioctl(I915_GEM_USERPTR) failed. Try running as root but expect poor stability.\n");
+      }
       goto err_free;
+   }
    bo->gem_handle = arg.handle;
 
    /* Check the buffer for validity before we try and use it in a batch */
--- a/src/gallium/drivers/iris/i915/iris_kmd_backend.c
+++ b/src/gallium/drivers/iris/i915/iris_kmd_backend.c
@@ -453,8 +453,20 @@
       .user_size = size,
       .flags = devinfo->has_userptr_probe ? I915_USERPTR_PROBE : 0,
    };
-   if (intel_ioctl(iris_bufmgr_get_fd(bufmgr), DRM_IOCTL_I915_GEM_USERPTR, &arg))
+
+   int ret;
+retry:
+   ret = intel_ioctl(iris_bufmgr_get_fd(bufmgr), DRM_IOCTL_I915_GEM_USERPTR, &arg);
+   if (ret) {
+      if (errno == ENODEV && arg.flags == 0) {
+         arg.flags = I915_USERPTR_UNSYNCHRONIZED;
+         goto retry;
+      }
+      if (geteuid() != 0) {
+         fprintf(stderr, "%s", "ioctl(I915_GEM_USERPTR) failed. Try running as root but expect poor stability.\n");
+      }
       return 0;
+   }
 
    if (!devinfo->has_userptr_probe) {
       /* Check the buffer for validity before we try and use it in a batch */
--- a/src/intel/vulkan_hasvk/anv_gem.c
+++ b/src/intel/vulkan_hasvk/anv_gem.c
@@ -150,9 +150,19 @@
    if (device->physical->info.has_userptr_probe)
       userptr.flags |= I915_USERPTR_PROBE;
 
-   int ret = intel_ioctl(device->fd, DRM_IOCTL_I915_GEM_USERPTR, &userptr);
-   if (ret == -1)
+   int ret;
+retry:
+   ret = intel_ioctl(device->fd, DRM_IOCTL_I915_GEM_USERPTR, &userptr);
+   if (ret == -1) {
+      if (errno == ENODEV && userptr.flags == 0) {
+         userptr.flags = I915_USERPTR_UNSYNCHRONIZED;
+         goto retry;
+      }
+      if (geteuid() != 0) {
+         fprintf(stderr, "%s", "ioctl(I915_GEM_USERPTR) failed. Try running as root but expect poor stability.\n");
+      }
       return 0;
+   }
 
    return userptr.handle;
 }
